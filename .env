# ============================================================================
# NEXUSDL - Environment Variables (PRODUCTION)
# ============================================================================
# ⚠️ NE JAMAIS COMMITER CE FICHIER DANS GIT
# ⚠️ Ce fichier contient vos vraies clés et identifiants
# ============================================================================

# ============================================================================
# 1. CONFIGURATION GÉNÉRALE
# ============================================================================
NEXUSDL_ENV=production
NEXUSDL_LOG_LEVEL=INFO
NEXUSDL_APP_NAME=NexusDL
NEXUSDL_APP_VERSION=0.1.0
PYTHONUNBUFFERED=1

# ============================================================================
# 2. SÉCURITÉ & AUTHENTIFICATION
# ============================================================================
# Clé secrète JWT (générée le 2026-09-27)
NEXUSDL_SECRET_KEY=DQXuIo2-1s7HKiVS7I_XVSxQPhJtm5opiR70iI5T7plgZ2s3PjwLNUrmibAcV3zKbAa3mDlLzBvV4hYXmAqkcA

# Identifiants administrateur
NEXUSDL_ADMIN_EMAIL=drxenon487@gmail.com
NEXUSDL_ADMIN_PASSWORD=Nexus2026@

# Clé API pour accès externes (générée le 2026-09-27)
NEXUSDL_API_KEY=nxd_f1c8984441aacdabe89ca4b24649a1e2ae83b2fcc15727f8b54cc057ce48f726

# ============================================================================
# 3. RÉSEAU & CORS
# ============================================================================
HOST=0.0.0.0
PORT=8000

# Origines CORS autorisées (Frontend Netlify + dev local)
NEXUSDL_CORS_ORIGINS=https://nexusdldev.netlify.app,http://localhost:3000,http://127.0.0.1:3000

# ============================================================================
# 4. CHEMINS DE STOCKAGE (pour Railway/Docker)
# ============================================================================
NEXUSDL_DATA_DIR=/app/data
NEXUSDL_DOWNLOAD_DIR=/app/data/downloads
NEXUSDL_LIBRARY_DIR=/app/data/library
NEXUSDL_CACHE_DIR=/app/cache
NEXUSDL_LOG_DIR=/app/logs
NEXUSDL_DB_PATH=/app/data/nexusdl.db
DATABASE_URL=sqlite:////app/data/nexusdl.db

# ============================================================================
# 5. PERFORMANCE & LIMITES
# ============================================================================
NEXUSDL_MAX_CONCURRENT_DOWNLOADS=3
NEXUSDL_MAX_CONCURRENT_PAGES=5
NEXUSDL_REQUEST_TIMEOUT=30

# ============================================================================
# 6. FRONTEND NEXT.JS (pour Netlify)
# ============================================================================
# URL de l'API (chemin relatif pour profiter du proxy Netlify)
NEXT_PUBLIC_API_URL=/api/v1

# URL WebSocket (connexion directe vers Railway)
NEXT_PUBLIC_WS_URL=wss://nexus-dl-production.up.railway.app/ws

# Méta-données frontend
NEXT_PUBLIC_APP_NAME=NexusDL
NEXT_PUBLIC_APP_VERSION=0.1.0
NODE_VERSION=20

# ============================================================================
# 7. CORRECTIONS SPÉCIFIQUES RAILWAY
# ============================================================================
# Désactive la vérification d'attestation GitHub pour Python via mise
MISE_PYTHON_GITHUB_ATTESTATIONS=false

# Installe automatiquement les dépendances système Playwright
RAILPACK_PYTHON_PLAYWRIGHT_INSTALL=1

# ============================================================================
# 8. URLs DE RÉFÉRENCE (commentaires, pas utilisées par l'app)
# ============================================================================
# Frontend Netlify : https://nexusdldev.netlify.app
# Backend Railway  : https://nexus-dl-production.up.railway.app
# GitHub Repo      : https://github.com/JokerApocalypse-cmd/Nexus-DL
# Documentation    : https://nexus-dl-production.up.railway.app/docs
